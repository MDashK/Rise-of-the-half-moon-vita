# Incrementa o número de compilação e gera version.h com a versão "X.YY" (v1.00 + 0,01 por compilação).
set(F "${SRC}/build_number.txt")
if(EXISTS "${F}")
  file(READ "${F}" N)
  string(STRIP "${N}" N)
else()
  set(N 0)
endif()
math(EXPR N "${N} + 1")
file(WRITE "${F}" "${N}\n")
math(EXPR V "100 + ${N}")
math(EXPR MAJ "${V} / 100")
math(EXPR MIN "${V} % 100")
if(MIN LESS 10)
  set(MIN "0${MIN}")
endif()
file(WRITE "${OUT}" "#pragma once\n#define RHM_VERSION \"${MAJ}.${MIN}\"\n#define RHM_BUILD ${N}\n")
