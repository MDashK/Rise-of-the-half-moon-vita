<Window x:Class="RiseHalfMoon.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About" Width="680" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/icon.ico"
        Background="#2B1729" PreviewKeyDown="OnKeyDown">
    <Border BorderBrush="{StaticResource Accent}" BorderThickness="0,1,0,0" Padding="28,24,28,22">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/Assets/icon.png" Width="64" Height="64" VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                    <TextBlock Text="Rise of the Half Moon" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}" />
                    <TextBlock x:Name="VersionText" FontSize="14" Margin="1,4,0,0" Foreground="{StaticResource InkMuted}" />
                    <TextBlock Text="Port by MDashK / AI assisted by Claude" FontSize="15" Margin="1,4,0,0"
                               Foreground="{StaticResource Accent}" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="GoogleText" TextWrapping="Wrap" FontSize="13.5" Margin="0,20,0,0" Foreground="{StaticResource Ink}" />
            <TextBlock x:Name="UnofficialText" TextWrapping="Wrap" FontSize="13.5" Margin="0,10,0,0" Foreground="{StaticResource Ink}" />

            <TextBlock x:Name="ThirdPartyTitle" FontSize="13.5" FontWeight="SemiBold" Margin="0,16,0,4"
                       Foreground="{StaticResource Ink}" />
            <ItemsControl x:Name="ThirdPartyList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,1"
                                   Foreground="{StaticResource InkMuted}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button x:Name="CloseButton" Style="{StaticResource PillButton}" HorizontalAlignment="Center" MinWidth="140"
                    Margin="0,20,0,0" IsDefault="True" IsCancel="True" Click="OnCloseClick" />
        </StackPanel>
    </Border>
</Window>
