<Window x:Class="RiseHalfMoon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Rise of the Half Moon"
        Icon="pack://application:,,,/Assets/icon.ico"
        Width="1180" Height="820" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#1A0F1F"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <LinearGradientBrush x:Key="SkyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#140B19" Offset="0" />
            <GradientStop Color="#2E1730" Offset="0.55" />
            <GradientStop Color="#4E2635" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="GameCardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                                BorderThickness="1" CornerRadius="14" Padding="12" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Card" Property="Background" Value="#4A2B44" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#5A3352" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ===================== MENU ===================== -->
        <Grid x:Name="MenuView" Background="{StaticResource SkyBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="28,22,28,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="🌗  Rise of the Half Moon" FontFamily="Georgia" FontSize="32"
                               Foreground="{StaticResource Ink}" />
                    <TextBlock x:Name="SubtitleText"
                               FontSize="14" Margin="2,6,0,0" Foreground="{StaticResource InkMuted}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="LanguageLabel" Foreground="{StaticResource InkMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="LanguageBox" Width="190" Height="30" VerticalContentAlignment="Center"
                              DisplayMemberPath="Name" SelectionChanged="OnLanguageChanged" />
                    <Button x:Name="DownloadButton" Style="{StaticResource PillButton}" Margin="14,0,0,0"
                            Click="OnDownloadClick" />
                    <Button x:Name="AboutButton" Style="{StaticResource PillButton}" Margin="8,0,0,0" Padding="14,8"
                            Content="?" FontWeight="SemiBold" Click="OnAboutClick" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="18,8">
                <ItemsControl x:Name="GamesList" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource GameCardButton}" Click="OnGameCardClick" Tag="{Binding}"
                                    ToolTip="{Binding Tooltip}">
                                <StackPanel>
                                    <Border Height="120" CornerRadius="8" Background="#F7F2EE" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="🌗" FontSize="54" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding PlaceholderVisibility}" />
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="6"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontSize="19" FontFamily="Georgia" Margin="2,12,0,0"
                                               Foreground="{StaticResource Ink}" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Margin="2,2,0,0"
                                               Foreground="{StaticResource InkMuted}" />
                                    <Border HorizontalAlignment="Left" Margin="0,10,0,0" CornerRadius="9" Padding="9,3"
                                            Background="{Binding StatusBrush}">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#1A0F1F" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#22000000" Padding="28,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="StatusText" Foreground="{StaticResource InkMuted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <ProgressBar x:Name="DownloadProgressBar" Height="4" Margin="0,6,0,0" Visibility="Collapsed"
                                     Foreground="{StaticResource Accent}" Background="#33FFFFFF" BorderThickness="0" />
                    </StackPanel>
                    <Button x:Name="OpenFolderButton" Grid.Column="1" Style="{StaticResource PillButton}" Padding="12,4" FontSize="12" Margin="16,0,0,0"
                            Click="OnOpenFolderClick" />
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== JOGO ===================== -->
        <Grid x:Name="GameView" Visibility="Collapsed" Background="#1A0F1F">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="GameToolbar" Background="#2B1729" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="MenuButton" Style="{StaticResource PillButton}" Click="OnBackClick" Padding="14,5" />
                    <TextBlock x:Name="GameTitle" Grid.Column="1" Margin="16,0" VerticalAlignment="Center" FontFamily="Georgia"
                               FontSize="17" Foreground="{StaticResource Ink}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="RestartButton" Style="{StaticResource PillButton}" Click="OnReloadClick" Padding="14,5" Margin="0,0,8,0" />
                        <Button x:Name="FullscreenButton" Style="{StaticResource PillButton}" Click="OnFullscreenClick" Padding="14,5" />
                    </StackPanel>
                </Grid>
            </Border>
            <wv2:WebView2 x:Name="WebView" Grid.Row="1" DefaultBackgroundColor="White" />
        </Grid>
    </Grid>
</Window>
