<Application x:Class="RiseHalfMoon.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="OnStartup"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="Ink" Color="#F6E7DA" />
        <SolidColorBrush x:Key="InkMuted" Color="#C9A9A6" />
        <SolidColorBrush x:Key="Accent" Color="#E8B48C" />
        <SolidColorBrush x:Key="CardBg" Color="#3A2236" />
        <SolidColorBrush x:Key="CardBorder" Color="#7A4A5C" />

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="#55304A" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6D3D5C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
